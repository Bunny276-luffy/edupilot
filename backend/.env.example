# LLM Provider Configuration: mock | ollama | openrouter | gemini
LLM_PROVIDER=mock

# Ollama settings (no key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# OpenRouter settings (free tier available)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free

# Gemini settings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# MongoDB
MONGODB_URI=
MONGODB_DB_NAME=edupilot

# Elasticsearch
ELASTIC_ENDPOINT=
ELASTIC_API_KEY=

# Arize Phoenix
ARIZE_API_KEY=
ARIZE_SPACE_KEY=
ARIZE_MODEL_ID=edupilot-gemini

# CORS Configurations (comma-separated origins or * for allow all)
CORS_ORIGINS=*
